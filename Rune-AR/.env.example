# Copy to .env and fill in values: cp .env.example .env
# Backend (docker compose) loads this file via env_file.

OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL — use the same user, password, and database as your Postgres container.
# Default (matches README): Postgres in a container on the host; backend uses host.docker.internal
# (docker-compose adds host.docker.internal on Linux via host-gateway).
DATABASE_URL=postgresql://rune_pg_user:securepassword123@host.docker.internal:5432/runedb
