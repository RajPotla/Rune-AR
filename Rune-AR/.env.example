# Copy to .env and fill in real values: cp .env.example .env
# Backend (loaded via docker-compose env_file and local Python load_dotenv)

OPENAI_API_KEY=your_openai_api_key_here

# Match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB from your rune-postgres container.
# With docker-compose, host.docker.internal reaches Postgres on the host (see extra_hosts in docker-compose.yml on Linux).
DATABASE_URL=postgresql://rune_pg_user:securepassword123@host.docker.internal:5432/runedb
